# App Configuration
VITE_APP_ID=your_app_id_here
VITE_APP_TITLE=English Learning App
VITE_OAUTH_PORTAL_URL=https://your-oauth-server.com

# Database
DATABASE_URL=mysql://username:password@localhost:3306/english_learning_app

# OAuth Server
OAUTH_SERVER_URL=https://your-oauth-server.com
OWNER_OPEN_ID=your_owner_open_id

# JWT Secret (generate a random string, at least 32 characters)
JWT_SECRET=your_random_secret_key_here_min_32_chars

# AI Services (Manus Forge API)
BUILT_IN_FORGE_API_URL=https://your-forge-api.com
BUILT_IN_FORGE_API_KEY=your_forge_api_key

# AWS S3 (for audio storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your_bucket_name
